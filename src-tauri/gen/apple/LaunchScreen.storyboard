    <resources>
        <!-- ⭐ 2026-10-19, nouvelle marque : l'écran de lancement EST la première
             image de l'animation d'entrée. Fond nuit (#070506) dans les DEUX
             apparences, halo rouge, l'icône centrée SANS lueur. L'app repart
             exactement de là (src/index.css, section « lancement ») : même
             fond, même halo (LaunchHalo est rendu depuis le même dégradé CSS
             par tools/icones-marque.mjs), même icône au même centre, 96 points.

             Le fond ne suit plus l'apparence du système : c'est voulu, la
             marque se montre sur la nuit dans les deux cas.

             ⚠️ Aucun double tiret dans ce commentaire. XML l'interdit et
             ibtool casse le build dessus, sans que rien d'autre ne le
             signale (constaté le 2026-09-11). -->
        <namedColor name="LaunchBackground">
            <color red="0.027450980392156862" green="0.019607843137254902" blue="0.023529411764705882" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
